    -- Cenário 2: Atualização
    ELSIF UPDATING and :NEW.CD_COLABORADOR is not null THEN
        UPDATE T_COLABORADOR 
        SET CD_SETOR = :NEW.CD_SETOR
        WHERE CD_COLABORADOR = :NEW.CD_COLABORADOR;

    -- Cenário 3: Exclusão
    ELSIF DELETING THEN
        UPDATE T_COLABORADOR 
        SET CD_SETOR = null
        WHERE CD_COLABORADOR = :NEW.CD_COLABORADOR;
    END IF;
END;
