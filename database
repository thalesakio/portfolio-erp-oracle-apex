create or replace trigger TRG_PROCESSO_AI
after insert
on T_PROCESSO
for each row
declare
    L_CD_PROC_FLUXO number;

begin

    /*
        Obtém o fluxo configurado para o processo.
    */
    select
        CD_PROC_FLUXO
    into
        L_CD_PROC_FLUXO
    from T_CONFIG_PROCESSO
    where CD_CONFIG_PROCESSO = :NEW.CD_CONFIG_PROCESSO
      and ATIVO = 'S';

    /*
        Copia todas as etapas parametrizadas
        para o processo.
    */
    insert into T_PROCESSO_ETAPA
    (
        CD_PROCESSO,
        CD_PROC_FLUXO_ETAPA,
        CD_STATUS,
        DH_INICIO,
        DH_PRAZO,
        CD_RESPONSAVEL
    )
    select
        :NEW.CD_PROCESSO,
        CD_PROC_FLUXO_ETAPA,

        case
            when ORDINAL_PAI is null then
                2
            else 1
        end, --CD_STATUS

        case
            when ORDINAL_PAI is null then
                localtimestamp
            else null
        end, --DH_INICIO

        case
            when ORDINAL_PAI is null then
                localtimestamp
                     + numtodsinterval(
                         SLA_HORAS,
                         'HOUR'
                     )
            else null
        end, --DH_PRAZO

        case
            when CD_SETOR_RESP is null then
                :NEW.CD_SOLICITANTE
            else null
        end

    from T_PROC_FLUXO_ETAPA
    where CD_PROC_FLUXO = L_CD_PROC_FLUXO
      and ATIVO = 'S';

exception

    when no_data_found then

        raise_application_error(
            -20012,
            'Não foi encontrado um fluxo ativo para a configuração do processo.'
        );

end;
