  CREATE OR REPLACE EDITIONABLE TRIGGER "TRG_ORGANOGRAMA_BIU" 
before insert or update of
    CD_SETOR,
    CD_FUNCAO_ESPECIFICA,
    CD_COLABORADOR
on T_ORGANOGRAMA
for each row

declare
    L_CD_EMPRESA            T_SETOR.CD_EMPRESA%type;
    L_CD_CONTRATO           T_SETOR.CD_CONTRATO%type;
    L_CD_FUNCAO_COLABORADOR T_COLABORADOR.CD_FUNCAO_ESPECIFICA%type;
    L_EXISTE                number;

begin

    /*
        Obtém empresa e contrato do setor.
    */
    select
        CD_EMPRESA,
        CD_CONTRATO
    into
        L_CD_EMPRESA,
        L_CD_CONTRATO
    from T_SETOR
    where CD_SETOR = :NEW.CD_SETOR;


    /*
        Valida a função específica.
    */
    select count(*)
    into L_EXISTE
    from T_FUNCAO_ESPECIFICA
    where CD_FUNCAO_ESPECIFICA = :NEW.CD_FUNCAO_ESPECIFICA
      and CD_EMPRESA = L_CD_EMPRESA
      and CD_CONTRATO = L_CD_CONTRATO;

    if L_EXISTE = 0 then

        raise_application_error(
            -20003,
            'A função específica deve pertencer à mesma empresa e contrato do setor.'
        );

    end if;


    /*
        A cadeira pode estar vaga.
    */
    if :NEW.CD_COLABORADOR is not null then

        /*
            Valida se o colaborador pertence
            à mesma empresa e contrato do setor.
        */
        select count(*)
        into L_EXISTE
        from T_COLABORADOR
        where CD_COLABORADOR = :NEW.CD_COLABORADOR
          and CD_EMPRESA = L_CD_EMPRESA
          and CD_CONTRATO = L_CD_CONTRATO;

        if L_EXISTE = 0 then

            raise_application_error(
                -20004,
                'O colaborador deve pertencer à mesma empresa e contrato do setor.'
            );

        end if;


        /*
            Obtém a função específica do colaborador.
        */
        select
            CD_FUNCAO_ESPECIFICA
        into
            L_CD_FUNCAO_COLABORADOR
        from T_COLABORADOR
        where CD_COLABORADOR = :NEW.CD_COLABORADOR;


        /*
            Valida se a função do colaborador
            corresponde à cadeira.
        */
        if L_CD_FUNCAO_COLABORADOR <> :NEW.CD_FUNCAO_ESPECIFICA then

            raise_application_error(
                -20005,
                'A função específica do colaborador não corresponde à função da cadeira do organograma.'
            );

        end if;

    end if;

end;
/
