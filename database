create or replace procedure P_CALCULA_PRAZO_PROCESSO (
    p_cd_processo in T_PROCESSO.CD_PROCESSO%type
) is
    --L_CD_PROCESSO       T_PROCESSO_ETAPA.CD_PROCESSO%type;
    --L_CD_PROC_FLUXO_ETAPA T_PROCESSO_ETAPA.CD_PROC_FLUXO_ETAPA%type;
    L_CD_CONFIG_PROCESSO number;
    L_SLA_HORAS number;
    L_AR_PROXIMA_ETAPA  varchar(100);

begin

    select CD_CONFIG_PROCESSO into L_CD_CONFIG_PROCESSO
    from T_PROCESSO
    where CD_PROCESSO = p_cd_processo;


    select SLA_HORAS into L_SLA_HORAS
    from T_CONFIG_PROCESSO
    where CD_CONFIG_PROCESSO = L_CD_CONFIG_PROCESSO;

    if L_SLA_HORAS is null then

        select sum(SLA_HORAS) into L_SLA_HORAS
        from T_PROC_FLUXO_ETAPA
        where CD_PROC_FLUXO = (
            select CD_PROC_FLUXO from T_CONFIG_PROCESSO
            where CD_CONFIG_PROCESSO = L_CD_CONFIG_PROCESSO
        );

    end if;

    update T_PROCESSO set
        DH_PRAZO = DH_ABERTURA + numtodsinterval(L_SLA_HORAS, 'HOUR')
    where CD_PROCESSO = p_cd_processo;

end P_CALCULA_PRAZO_PROCESSO;
/
create or replace procedure P_CONCLUIR_ETAPA (
    p_cd_processo_etapa in T_PROCESSO_ETAPA.CD_PROCESSO_ETAPA%type,
    P_app_cd_usu number
) is
    L_CD_PROCESSO       T_PROCESSO_ETAPA.CD_PROCESSO%type;
    L_CD_PROC_FLUXO_ETAPA T_PROCESSO_ETAPA.CD_PROC_FLUXO_ETAPA%type;
    L_AR_PROXIMA_ETAPA  varchar(100);
begin

    -- 1. Atualiza e Conclui a etapa atual
    update T_PROCESSO_ETAPA
    set CD_STATUS = 3,
        DH_CONCLUSAO = localtimestamp,
        CD_RESPONSAVEL = p_app_cd_usu
        where CD_PROCESSO_ETAPA = p_cd_processo_etapa
    returning CD_PROCESSO, CD_PROC_FLUXO_ETAPA into L_CD_PROCESSO, L_CD_PROC_FLUXO_ETAPA;

    -- 2. Busca a próxima etapa do fluxo
    select listagg(ORDINAL, ',') within group (order by ORDINAL)
        into L_AR_PROXIMA_ETAPA
    from T_PROC_FLUXO_ETAPA
        where CD_PROC_FLUXO = (select CD_PROC_FLUXO from T_PROC_FLUXO_ETAPA where CD_PROC_FLUXO_ETAPA = L_CD_PROC_FLUXO_ETAPA)
            and ORDINAL_PAI = ( 
                select ORDINAL from T_PROC_FLUXO_ETAPA where CD_PROC_FLUXO_ETAPA = L_CD_PROC_FLUXO_ETAPA
            );

    if L_AR_PROXIMA_ETAPA is not null then

        -- 3. Inicia as próximas etapas encontradas
        for i in (
            select pe.CD_PROCESSO_ETAPA, fe.SLA_HORAS
            from T_PROCESSO_ETAPA pe
            join T_PROC_FLUXO_ETAPA fe on fe.CD_PROC_FLUXO_ETAPA = pe.CD_PROC_FLUXO_ETAPA
                where pe.CD_PROCESSO = L_CD_PROCESSO
                    and fe.ORDINAL in (
                      select regexp_substr(L_AR_PROXIMA_ETAPA, '[^,]+', 1, level) 
                      from dual 
                      connect by level <= regexp_count(L_AR_PROXIMA_ETAPA, ',') + 1
                    )
        ) loop

            update T_PROCESSO_ETAPA
            set CD_STATUS = 2,
                DH_INICIO = localtimestamp,
                DH_PRAZO = localtimestamp + numtodsinterval(i.SLA_HORAS, 'HOUR')
                where CD_PROCESSO_ETAPA = i.CD_PROCESSO_ETAPA;

        end loop;
    
    else

        -- 4. Não existem mais etapas. Finaliza o processo principal.
        update T_PROCESSO
        set CD_STATUS = 3,
            DH_CONCLUSAO = localtimestamp
            where CD_PROCESSO = L_CD_PROCESSO;

    end if;

end P_CONCLUIR_ETAPA;
/





