  select
    p.CD_PROCESSO,
    p.CD_CONFIG_PROCESSO,
    cp.CD_SETOR,
    ts.CD_TP_SETOR,
    ts.NM_SETOR,
    tp.CD_TP_PROCESSO,
    tp.NM_PROCESSO,
    pf.CD_PROC_FLUXO,
    pf.NM_PROC_FLUXO,
    s.CD_EMPRESA,
    e.NM_EMPRESA,
    s.CD_CONTRATO,
    c.NM_CONTRATO,
    p.CD_SOLICITANTE,
    u.NOME NM_SOLICITANTE,
    p.TITULO_PROCESSO,
    p.DS_PROCESSO,
    p.CD_STATUS,
    st.NM_STATUS,
    p.DH_ABERTURA,
    p.DH_INICIO,
    p.DH_CONCLUSAO,
    p.DH_PRAZO
from T_PROCESSO p
    left join T_CONFIG_PROCESSO cp on cp.CD_CONFIG_PROCESSO = p.CD_CONFIG_PROCESSO
    left join T_SETOR s on s.CD_SETOR = cp.CD_SETOR
    left join T_TP_SETOR ts on ts.CD_TP_SETOR = s.CD_TP_SETOR
    left join T_TP_PROCESSO tp on tp.CD_TP_PROCESSO = cp.CD_TP_PROCESSO
    left join T_PROC_FLUXO pf on pf.CD_PROC_FLUXO = cp.CD_PROC_FLUXO
    left join T_EMPRESA e on e.CD_EMPRESA = s.CD_EMPRESA
    left join V_CONTRATO c on c.CD_CONTRATO = s.CD_CONTRATO and s.CD_EMPRESA = c.CD_EMPRESA
    left join T_USUARIO u on u.CD_USU = p.CD_SOLICITANTE
    left join T_TP_STATUS st on st.CD_STATUS = p.CD_STATUS and st.CD_TP_TABELA = 3;

  CREATE OR REPLACE FORCE EDITIONABLE VIEW "V_PROCESSO_ETAPA" ("CD_PROCESSO_ETAPA", "CD_PROCESSO", "CD_PROC_FLUXO_ETAPA", "CD_STATUS", "NM_STATUS", "DH_INICIO", "DH_PRAZO", "DH_CONCLUSAO", "CD_RESPONSAVEL", "CD_PROC_FLUXO", "ORDINAL", "ORDINAL_PAI", "NM_ETAPA", "DS_ETAPA", "SLA_HORAS", "CD_TP_RESPONSAVEL", "CD_SETOR_RESP", "CD_FUNCAO_ESP_RESP", "VERSAO", "CD_TP_ANEXO", "NM_PROC_FLUXO", "CD_ANEXO", "NM_ARQUIVO", "MIME_TYPE", "ARQUIVO", "TITULO_PROCESSO", "CD_STATUS_PROCESSO", "SITUACAO") AS 
  select
    e.CD_PROCESSO_ETAPA,
    e.CD_PROCESSO,
    e.CD_PROC_FLUXO_ETAPA,
    e.CD_STATUS,
    st.NM_STATUS,
    e.DH_INICIO,
    e.DH_PRAZO,
    e.DH_CONCLUSAO,
    e.CD_RESPONSAVEL,
    fe.CD_PROC_FLUXO,
    fe.ORDINAL,
    fe.ORDINAL_PAI,
    fe.NM_ETAPA,
    fe.DS_ETAPA,
    fe.SLA_HORAS,
    fe.CD_TP_RESPONSAVEL,
    fe.CD_SETOR_RESP,
    fe.CD_FUNCAO_ESP_RESP,
    fe.VERSAO,
    fe.CD_TP_ANEXO,
    f.NM_PROC_FLUXO,
    a.CD_ANEXO,
    a.NM_ARQUIVO,
    a.MIME_TYPE,
    a.ARQUIVO,
    p.TITULO_PROCESSO,
    p.CD_STATUS CD_STATUS_PROCESSO,

    case 
        -- TAREFA CANCELADA
        when e.CD_STATUS = 4 then 'Cancelada'

        -- TAREFA CONCLUÍDA
        when e.CD_STATUS in (3, 6) and e.DH_CONCLUSAO <= e.DH_PRAZO then 'Concluída'
        when e.CD_STATUS in (3, 6) and e.DH_CONCLUSAO > e.DH_PRAZO then 'Concluída fora do prazo'
        when e.CD_STATUS in (3, 6) and e.DH_PRAZO is null then 'Concluída' 

        -- TAREFAS ATIVAS (Em andamento) SEM PRAZO DEFINIDO
        when e.CD_STATUS IN (2, 5) and e.DH_PRAZO is null then 'Sem prazo'
        -- (Em espera) NO PRAZO
        when e.CD_STATUS IN (1) and e.DH_PRAZO is null then 'No prazo'

        -- TAREFAS ATIVAS QUE JÁ PASSARAM DO PRAZO
        when e.CD_STATUS IN (1, 2, 5) and localtimestamp > e.DH_PRAZO then 'Atrasada'

        -- TAREFAS ATIVAS PRÓXIMAS DO PRAZO Exemplo: Falta menos de 1 dia / 24 horas
        when e.CD_STATUS IN (1, 2, 5) and localtimestamp >= (e.DH_PRAZO - interval '1' day) and localtimestamp <= e.DH_PRAZO then 'Próxima do prazo'

        -- TAREFAS ATIVAS QUE ESTÃO CONFORME O CRONOGRAMA
        when e.CD_STATUS IN (1, 2, 5) and localtimestamp < (e.DH_PRAZO - interval '1' day) then 'No prazo'
        
        --  passe alguma inconsistência que não mapeamos acima
        else 'Indefinida'
    end as SITUACAO

from T_PROCESSO_ETAPA e
    left join T_PROC_FLUXO_ETAPA fe on fe.CD_PROC_FLUXO_ETAPA = e.CD_PROC_FLUXO_ETAPA
    left join T_PROC_FLUXO f on f.CD_PROC_FLUXO = fe.CD_PROC_FLUXO
    left join T_ANEXO a on a.CD_PK_TABELA = e.CD_PROCESSO_ETAPA and a.CD_TP_TABELA = 4 and a.CD_TP_ANEXO = 99
    left join T_PROCESSO p on p.CD_PROCESSO = e.CD_PROCESSO
    left join T_TP_STATUS st on st.CD_STATUS = e.CD_STATUS and st.CD_TP_TABELA = 4;

