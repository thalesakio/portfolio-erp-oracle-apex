create or replace FUNCTION F_APEX_AUTENTICAR (
    P_USERNAME IN VARCHAR2,
    P_PASSWORD IN VARCHAR2
) RETURN BOOLEAN
IS
BEGIN

    RETURN F_AUTENTICAR_USUARIO(
        P_LOGIN => P_USERNAME,
        P_SENHA => P_PASSWORD
    );

END;
/
create or replace FUNCTION F_AUTENTICAR_USUARIO (
    P_LOGIN IN VARCHAR2,
    P_SENHA IN VARCHAR2
) RETURN BOOLEAN
IS
    L_SENHA_HASH T_USUARIO.SENHA_HASH%TYPE;
BEGIN

    SELECT SENHA_HASH
      INTO L_SENHA_HASH
      FROM T_USUARIO
     WHERE UPPER(LOGIN) = UPPER(P_LOGIN)
       AND ATIVO = 'S';

    RETURN L_SENHA_HASH = F_HASH_SENHA(P_SENHA);

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN FALSE;

    WHEN TOO_MANY_ROWS THEN
        RETURN FALSE;
END;
/
create or replace FUNCTION F_CD_USU_LOGADO
RETURN NUMBER
IS
    V_CD_USU T_USUARIO.CD_USU%TYPE;
    V_LOGIN  T_USUARIO.LOGIN%TYPE;
BEGIN

    V_LOGIN := SYS_CONTEXT('APEX$SESSION', 'APP_USER');

    -- Se não houver usuário APEX identificado,
    -- considera execução técnica/desenvolvimento.
    IF V_LOGIN IS NULL OR V_LOGIN = 'SERVER' THEN
        RETURN 1;
    END IF;

    SELECT CD_USU
      INTO V_CD_USU
      FROM T_USUARIO
     WHERE LOGIN = V_LOGIN
       AND ATIVO = 'S';

    RETURN V_CD_USU;

EXCEPTION

    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(
            -20001,
            'Usuário APEX "' || V_LOGIN ||
            '" não está cadastrado ou está inativo em T_USUARIO.'
        );

    WHEN TOO_MANY_ROWS THEN
        RAISE_APPLICATION_ERROR(
            -20002,
            'Existem múltiplos usuários com o LOGIN "' ||
            V_LOGIN || '" em T_USUARIO.'
        );

END;
/
create or replace FUNCTION F_CD_USU_SESSAO
RETURN NUMBER
IS
    L_CD_USU T_USUARIO.CD_USU%TYPE;
BEGIN

    SELECT CD_USU
      INTO L_CD_USU
      FROM T_USUARIO
     WHERE UPPER(LOGIN) = UPPER(V('APP_USER'))
       AND ATIVO = 'S';

    RETURN L_CD_USU;

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN NULL;
END;
/
create or replace FUNCTION F_HASH_SENHA (
    P_SENHA IN VARCHAR2
) RETURN VARCHAR2
IS
    L_HASH VARCHAR2(64);
BEGIN

    SELECT STANDARD_HASH(P_SENHA, 'SHA256')
      INTO L_HASH
      FROM DUAL;

    RETURN LOWER(L_HASH);

END;
/





